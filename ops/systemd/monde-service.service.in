[Unit]
Description=Monde local API and MCP service
PartOf=monde-dev.target
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@MONDE_ROOT@
Environment=MONDE_HOST=127.0.0.1
Environment=MONDE_WEB_PORT=3761
Environment=MONDE_MCP_PORT=3762
Environment=MONDE_UI_PORT=5175
ExecStart=/usr/bin/npm run dev:service
Restart=always
RestartSec=2
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=monde-dev.target
